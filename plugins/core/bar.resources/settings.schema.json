{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resources",
  "type": "object",
  "properties": {
    "interval": {
      "type": "integer",
      "default": 3,
      "minimum": 1,
      "title": "Update interval in seconds"
    },
    "warnAt": {
      "type": "integer",
      "default": 85,
      "minimum": 1,
      "maximum": 100,
      "title": "Warn at this percentage"
    }
  }
}
