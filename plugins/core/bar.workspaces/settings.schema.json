{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workspaces",
  "type": "object",
  "properties": {
    "showEmpty": { "type": "boolean", "default": true, "title": "Show empty workspaces" },
    "style": { "type": "string", "enum": ["numbers", "roman", "dots", "circles"], "default": "numbers", "title": "Indicator style" },
    "showNames": { "type": "boolean", "default": false, "title": "Show names instead of the indicator style" }
  }
}
