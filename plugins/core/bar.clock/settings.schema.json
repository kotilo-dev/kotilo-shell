{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clock",
  "type": "object",
  "properties": {
    "format": { "type": "string", "default": "ddd d MMM  HH:mm", "title": "Date and time format (Qt)" },
    "localLabel": { "type": "string", "default": "", "title": "Label for local time (e.g. IST)" },
    "zones": {
      "type": "array", "title": "Extra time zones",
      "items": { "type": "object", "properties": { "label": { "type": "string" }, "tz": { "type": "string", "description": "IANA zone, e.g. America/Los_Angeles" } }, "required": ["label", "tz"] },
      "default": []
    }
  }
}
