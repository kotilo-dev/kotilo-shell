{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kotilo.dev/schemas/plugin-manifest.json",
  "title": "Kotilo Shell plugin manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "apiVersion",
    "kind",
    "slots"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "apiVersion": {
      "type": "string",
      "pattern": "^[\\^~]?\\d+(\\.(\\d+|x))?(\\.(\\d+|x))?$"
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 200
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "kind": {
      "enum": [
        "qml",
        "script",
        "provider"
      ]
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "bar.left",
          "bar.center",
          "bar.right",
          "controlcenter.tile",
          "dashboard.card",
          "dashboard.tab",
          "lock.widget",
          "osd.kind",
          "shell.overlay",
          "palette.provider",
          "theme.target",
          "notification.handler",
          "wm.adapter"
        ]
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "process",
          "network",
          "fs:read",
          "fs:write",
          "dbus"
        ]
      },
      "default": []
    },
    "settingsSchema": {
      "type": "string"
    },
    "barGroup": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Bar plugins with the same group sit close together"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "provider"
          }
        }
      },
      "then": {
        "properties": {
          "slots": {
            "items": {
              "enum": [
                "palette.provider",
                "theme.target",
                "notification.handler",
                "wm.adapter"
              ]
            }
          }
        }
      }
    }
  ]
}
