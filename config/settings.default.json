{
  "$schema": "https://kotilo.dev/schemas/settings.json",
  "version": 1,
  "theme": { "id": "catppuccin-mocha", "autoVariant": "off", "propagate": true },
  "animations": true,
  "bar": { "position": "top", "height": 36 },
  "slots": {
    "bar.left":   ["bar.logo", "bar.workspaces", "bar.windows", "bar.window-title"],
    "bar.center": ["bar.clock", "bar.git", "bar.agents", "bar.containers", "bar.ports"],
    "bar.right":  ["bar.resources", "bar.network", "bar.bluetooth", "bar.audio", "bar.battery", "bar.notifications", "bar.tray"],
    "dashboard.card": ["dash.weather", "dash.clock", "dash.calendar", "dash.resources", "dash.media"],
    "dashboard.tab": ["dash.performance", "dash.agents", "dash.github", "dash.rss"]
  },
  "plugins": {
    "bar.workspaces": { "showEmpty": true, "showNames": false },
    "bar.clock": { "format": "ddd d MMM  HH:mm", "localLabel": "", "zones": [] },
    "bar.battery": { "lowAt": 15 },
    "bar.window-title": { "maxLength": 60 }
  },
  "keybinds": {
    "palette": "Super+Space",
    "controlCenter": "Super+Shift+C",
    "focusMode": "Super+Shift+F"
  }
}
